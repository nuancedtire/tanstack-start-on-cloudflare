{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qip",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./src/server.ts",
  "vars": {
    "MY_VAR": "Hello from Cloudflare",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qip-db",
      "database_id": "2304eb59-1124-41f0-86a0-e4e9c93a6d1c"
    }
  ]
}